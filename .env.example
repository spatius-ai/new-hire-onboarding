# Required: from app.spatius.ai
SPATIUS_API_KEY=
SPATIUS_APP_ID=
# us-west (default) or your region
SPATIUS_REGION=us-west

# Optional: your own OpenAI key. Without it, the guide uses 30 free Spatius starter minutes.
OPENAI_API_KEY=

# Optional: where the page starts (the new hire can still change the language)
# Language: en, es, zh, ar, fr
ONBOARDING_LANG=en
# Your company, handbook, people and checklist, instead of the samples. Write \n for a new line.
# ONBOARDING_COMPANY=Example Ltd
# ONBOARDING_HANDBOOK=## Payday\nYou are paid on the last working day of the month.
# ONBOARDING_PEOPLE=Mei | IT | laptops, accounts | mailto:mei@example.com\nSam | People team | holidays, benefits | mailto:sam@example.com
# ONBOARDING_CHECKLIST=Get your laptop\nMeet your team
# Seconds per session (0 for no limit)
ONBOARDING_SECONDS=180
# PORT=3000
